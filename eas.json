{
	"cli": {
		"version": ">= 24.12.1",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"EXPO_PUBLIC_API_URL": "https://backend-labi.chevalierlabsas.org/api/v1"
			}
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"EXPO_PUBLIC_API_URL": "https://backend-labi.chevalierlabsas.org/api/v1"
			}
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"EXPO_PUBLIC_API_URL": "https://backend-labi.chevalierlabsas.org/api/v1"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
