{
  "expo": {
    "scheme": "labi",
    "name": "LABI",
    "slug": "labi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "backgroundColor": "#FFF8EE",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE",
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "monochromeImage": "./assets/icons/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joanpurba.labi"
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EE",
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/icons/splash-icon.png"
          }
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Izinkan LABI mengakses mikrofon untuk merekam cerita penyintas."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c240a79-2fc1-45b2-8825-3ede41b71d37"
      }
    }
  }
}
